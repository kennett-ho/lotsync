# LotSync backend -- environment variables.
#
# Every one of these is optional and already has a repo-relative local
# default (see config/settings.py, database/repository.py,
# utils/file_resolution.py, api/app.py, api/routers/inventory_sync.py).
# Nothing in this file is required for local development; copy it to
# .env only if you want to override a default. For a production
# deployment (Render), see DEPLOYMENT.md -- these are the exact
# variables set there, pointed at the persistent disk mount instead of
# a repo-relative path.

# --- Filesystem paths -------------------------------------------------
# Locally these all default to a repo-relative data/ subfolder. In
# production (Render) these should point at the persistent disk mount
# (e.g. /var/data/...) so the database and uploaded config survive
# deploys and restarts -- see DEPLOYMENT.md.

# SQLite database file. Directory is created automatically if missing.
LOTSYNC_DB_PATH=data/lotsync.db

# oms_config.xlsx (Store Name, aging-bucket thresholds, excluded VINs).
# This file itself is never generated by the app -- it must be uploaded
# to this path manually after deployment. Missing/misconfigured falls
# back to defaults silently (store_name='Mark Kia') -- see
# PRE_DEPLOYMENT_REVIEW.md's R2 finding.
LOTSYNC_CONFIG_PATH=data/uploads/oms_config.xlsx

# CLI-only (main.py's find_upload() folder). Not used by the web API
# path at all -- irrelevant to the Render deployment, only to running
# the original reconcile.py-style CLI workflow.
LOTSYNC_UPLOADS_DIR=data/uploads

# Where POST /inventory-sync/run stages each upload before processing
# (one timestamped subfolder per sync run). No automatic cleanup yet --
# see PRE_DEPLOYMENT_REVIEW.md's D5 finding.
LOTSYNC_API_UPLOADS_DIR=data/api_uploads

# Where the eight CSV reports are written after each sync.
LOTSYNC_OUT_DIR=data/outputs

# --- CORS ---------------------------------------------------------------
# Comma-separated list of origins allowed to call this API from a
# browser. Local default covers the Vite dev server's usual ports; in
# production set this to the deployed frontend's exact origin (e.g.
# https://lotsync.vercel.app) -- see DEPLOYMENT.md's ordering note
# (backend deploys before this can be set to a real value).
LOTSYNC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8443,http://127.0.0.1:8443

# --- Database engine (Sprint 03) --------------------------------------
# Which persistence engine connect() opens. Default (unset) is sqlite --
# production's engine, unchanged. DealerDOH DEV sets postgres, which
# requires DATABASE_URL (a PostgreSQL DSN; for the deployed dev API this
# is the Supabase SESSION-pooler connection string, since direct
# Supabase connections are IPv6-only from Render). DATABASE_URL is a
# SECRET (it embeds the database password) -- set it only in the Render
# dashboard or a local untracked file, never here, never in git.
# DATABASE_POOL_MAX (optional, default 4) caps the psycopg pool.
#DATABASE_ENGINE=postgres
#DATABASE_URL=
#DATABASE_POOL_MAX=4

# --- Environment identification (Sprint 02) ---------------------------
# Which environment this deployment is. Reported by GET /health so an
# operator can always tell which environment answered, and used by
# seed_dev.py as a guardrail (it refuses to run when this is
# "production"). The DealerDOH development Render service sets
# ENVIRONMENT=development; current production predates this variable
# and reports "unspecified". Unset locally is fine.
#ENVIRONMENT=development

# --- Local dev launcher only (tools/launch.ps1 / tools/common.ps1) -----
# Not read by the application itself (uvicorn's bind host/port are set
# via its own --host/--port flags, e.g. in a production start command).
# Only relevant if you use Launch LotSync.bat / tools/launch.ps1 locally.
LOTSYNC_BACKEND_HOST=127.0.0.1
LOTSYNC_BACKEND_PORT=8000
LOTSYNC_FRONTEND_PORT=8443

# --- Authentication (Sprint 05, DealerDOH DEV only) --------------------
# AUTH_MODE selects the API's posture. Default (unset) is "disabled":
# every route behaves exactly as before Sprint 05 -- the production
# path (production LotSync is a deliberately unauthenticated beta and
# sets NONE of this section). The DealerDOH DEV Render service sets
# "required": operational routes demand a valid Supabase-issued Bearer
# token AND an active user_membership row; /health stays public.
#AUTH_MODE=required

# Where token verification finds the project's public signing keys.
# Deployed: set SUPABASE_URL (the dev project URL) and the JWKS is
# fetched from <SUPABASE_URL>/auth/v1/.well-known/jwks.json; the
# expected issuer derives from the same value. These are PUBLIC values
# (the JWKS endpoint is unauthenticated by design) -- the secrets
# (service-role key, DB password) are never needed by the API for
# verification and must never appear here.
# Tests/CI instead inject AUTH_JWKS (inline JWKS JSON) and
# AUTH_JWT_ISSUER -- no live Supabase anywhere in CI.
#SUPABASE_URL=https://<project-ref>.supabase.co
#AUTH_JWT_ISSUER=
#AUTH_JWT_AUDIENCE=authenticated
#AUTH_JWKS=

# Which dealership this deployment serves (the access model's store
# boundary -- api/auth.py resolves every caller's membership against
# exactly this, never a client-supplied store). Defaults to the QA
# dealership the dev seed creates.
#DEALERDOH_DEALERSHIP_ID=qa-motors

# Frontend (Vercel DEV project only; baked at build time):
#   VITE_SUPABASE_URL        -- same public project URL
#   VITE_SUPABASE_ANON_KEY   -- the PUBLIC anon/publishable key ONLY.
#                               Never the service-role/secret key.
# Production LotSync's Vercel project sets neither, so its bundle has
# no auth surface at all.

# tools/provision_dev_auth.py additionally needs SUPABASE_SECRET_KEY
# (service-role) -- an operator-staged SECRET, same handling as
# DATABASE_URL: dashboard/env only, never committed, never printed.
#SUPABASE_SECRET_KEY=
