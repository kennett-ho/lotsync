# LotSync frontend -- environment variables.
#
# Copy to .env.local for local overrides (frontend/.gitignore already
# excludes .env*). Vite only exposes variables prefixed VITE_ to
# client code -- see src/api/client.ts.

# Base URL of the LotSync backend API. Defaults to
# http://localhost:8000 (api/app.py's local default) when unset.
#
# In production (Vercel), set this to the deployed Render backend's
# exact URL, e.g.:
#   VITE_API_BASE_URL=https://lotsync-api.onrender.com
#
# This is baked into the built JS at build time (Vite convention, not
# read at runtime) -- changing it on Vercel requires a redeploy, not
# just a dashboard save. See DEPLOYMENT.md.
VITE_API_BASE_URL=http://localhost:8000

# Sprint 02: set to "development" ONLY on the DealerDOH development
# deployment (and locally if you want the banner). Renders a permanent
# "DealerDOH DEV" banner so the dev environment can never be mistaken
# for production. Production builds must not set this.
#VITE_ENVIRONMENT=development

# Reserved for the Supabase Auth integration (Sprint 05 -- names
# documented now, nothing reads them yet). Only ever use the PUBLIC
# anon key in frontend config; service-role keys are server-only and
# never appear in any VITE_ variable.
#VITE_SUPABASE_URL=
#VITE_SUPABASE_ANON_KEY=

# Sprint 11 (observability -- see OBSERVABILITY.md). All three are
# intentionally browser-public identifiers when set; leaving them
# unset disables the corresponding layer entirely (the app runs
# unchanged). NEVER put a Sentry auth token or a PostHog personal API
# key in ANY VITE_ variable -- those are privileged secrets and no
# frontend code may reference them.
#VITE_SENTRY_DSN=
#VITE_POSTHOG_KEY=
#VITE_POSTHOG_HOST=https://us.i.posthog.com
